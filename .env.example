# Produção (Vercel): deixe vazio — vercel.json faz proxy de /api e /uploads para a VPS.
# VITE_API_URL=

# Desenvolvimento local: proxy Vite → VPS (default). API local:
# VITE_DEV_API_TARGET=http://127.0.0.1:8000

# WebSocket da /tela: na Vercel o proxy HTTP não garante WS — a tela usa também polling automático (~2s).
# Se abrir /tela na mesma origem HTTP da API (VPS), pode definir:
# VITE_WS_URL=http://84.247.136.129
